{
  "name": "companyai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI agent company: hire agents, assign work, run meetings",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"engine/**/*.test.ts\" \"server/**/*.test.ts\" \"web/src/office/**/*.test.ts\"",
    "fake-hermes": "tsx engine/testing/fake-hermes.ts",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "node scripts/deploy-cloudflare.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wrangler": "^4.147.0"
  }
}
