{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "companyai",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": { "bindings": [{ "name": "COMPANY", "class_name": "CompanyDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CompanyDO"] }],
  // The id below is a placeholder: `npm run cf:setup` creates the real Hyperdrive and fills it in.
  // localConnectionString is only for `wrangler dev` on your own computer.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://companyai:companyai@127.0.0.1:5432/companyai"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "companyai-files" }],
  "observability": { "enabled": true }
}
